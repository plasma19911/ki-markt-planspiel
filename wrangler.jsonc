{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ki-markt-planspiel",
  "main": "src/index-v18.js",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "secrets": {
    "required": ["PC_AGENT_TOKEN"]
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Statische Dateien wie app.js, CSS und universe.json werden direkt aus dem
    // Asset-Layer bedient. Nur API sowie die Haupt-HTML-Routen laufen zuerst
    // durch den Worker, damit API-Routing und no-store fuer die App erhalten bleiben.
    "run_worker_first": ["/api/*", "/", "/index.html"]
  },

  "ai": {
    "binding": "AI"
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "PORTFOLIO",
        "class_name": "MarketPortfolio"
      }
    ]
  },

  "exports": {
    "MarketPortfolio": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },

  "triggers": {
    "crons": ["*/5 5-22 * * 1-5"]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
