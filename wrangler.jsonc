{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ki-markt-planspiel",
  "main": "src/index.js",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/app.js"]
  },

  "ai": {
    "binding": "AI"
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "PORTFOLIO",
        "class_name": "MarketPortfolio"
      }
    ]
  },

  "exports": {
    "MarketPortfolio": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },

  "triggers": {
    "crons": ["* * * * *"]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
