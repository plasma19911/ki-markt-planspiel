{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ki-markt-planspiel",
  "main": "src/index-v18.js",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "secrets": {
    "required": ["PC_AGENT_TOKEN"]
  },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Grosse/stabile Dateien wie app.js, CSS und universe.json werden direkt aus
    // dem Asset-Layer bedient. quota-guard.js bleibt worker-first, weil dort die
    // aktuellen Depot-/Replay-/Quota-Hotfixes sitzen und alte Browser-Caches sonst
    // sichtbar einen veralteten Depotstand rendern koennen.
    "run_worker_first": ["/api/*", "/", "/index.html", "/quota-guard.js"]
  },

  "ai": {
    "binding": "AI"
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "PORTFOLIO",
        "class_name": "MarketPortfolio"
      }
    ]
  },

  "exports": {
    "MarketPortfolio": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },

  "triggers": {
    "crons": ["*/5 5-22 * * 1-5"]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
